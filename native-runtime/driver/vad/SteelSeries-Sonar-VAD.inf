;======================================================
; SteelSeries_Sonar_VAD_SA
;======================================================
[SteelSeries_Sonar_VAD_SA.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration, MsApoFxProxy.Registration
CopyFiles=SteelSeries_Sonar_VAD_SA.CopyList
AddReg=SteelSeries_Sonar_VAD_SA.AddReg

[SteelSeries_Sonar_VAD_SA.NT.Interfaces]
;
; Interfaces for game render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_game_wave_speaker%, SteelSeries_Sonar_VAD.Game.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_game_wave_speaker%, SteelSeries_Sonar_VAD.Game.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_game_topology_speaker%, SteelSeries_Sonar_VAD.Game.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_game_topology_speaker%, SteelSeries_Sonar_VAD.Game.I.TopologySpeaker

;
; Interfaces for chat render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_chat_wave_speaker%, SteelSeries_Sonar_VAD.Chat.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_chat_wave_speaker%, SteelSeries_Sonar_VAD.Chat.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_chat_topology_speaker%, SteelSeries_Sonar_VAD.Chat.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_chat_topology_speaker%, SteelSeries_Sonar_VAD.Chat.I.TopologySpeaker

;
; Interfaces for chat capture endpoint 
;
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_chat_capture_wave%, SteelSeries_Sonar_VAD.ChatCapture.I.Wave
AddInterface=%KSCATEGORY_CAPTURE%,  %KSNAME_chat_capture_wave%, SteelSeries_Sonar_VAD.ChatCapture.I.Wave
AddInterface=%KSCATEGORY_RENDER%,   %KSNAME_chat_capture_wave%, SteelSeries_Sonar_VAD.ChatCapture.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_chat_capture_topology%, SteelSeries_Sonar_VAD.ChatCapture.I.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_chat_capture_topology%, SteelSeries_Sonar_VAD.ChatCapture.I.Topology

;
; Interfaces for media render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,	%KSNAME_media_wave_speaker%, SteelSeries_Sonar_VAD.Media.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%,	%KSNAME_media_wave_speaker%, SteelSeries_Sonar_VAD.Media.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%,	%KSNAME_media_topology_speaker%, SteelSeries_Sonar_VAD.Media.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_media_topology_speaker%, SteelSeries_Sonar_VAD.Media.I.TopologySpeaker

;
; Interfaces for aux render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%,	%KSNAME_aux_wave_speaker%, SteelSeries_Sonar_VAD.Aux.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%,	%KSNAME_aux_wave_speaker%, SteelSeries_Sonar_VAD.Aux.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%,	%KSNAME_aux_topology_speaker%, SteelSeries_Sonar_VAD.Aux.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_aux_topology_speaker%, SteelSeries_Sonar_VAD.Aux.I.TopologySpeaker

;
; Interfaces for stream render endpoint.
;
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_stream_wave%, SteelSeries_Sonar_VAD.Stream.I.Wave
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_stream_wave%, SteelSeries_Sonar_VAD.Stream.I.Wave
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_stream_topology%, SteelSeries_Sonar_VAD.Stream.I.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_stream_topology%, SteelSeries_Sonar_VAD.Stream.I.Topology

[SteelSeries_Sonar_VAD_SA.NT.Services]
AddService=SteelSeries_Sonar_VAD,0x00000002,SteelSeries_Sonar_VAD_Service_Inst

[SteelSeries_Sonar_VAD_Service_Inst]
DisplayName=%SteelSeries_Sonar_VAD.SvcDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SteelSeries-Sonar-VAD.sys

[SteelSeries_Sonar_VAD_SA.NT.HW]
AddReg = AUDIOHW.AddReg

[AUDIOHW.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

