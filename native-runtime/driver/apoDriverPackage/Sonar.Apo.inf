[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %Provider%
DriverVer = 09/09/2026,3.9.0.0
CatalogFile = Sonar.APO.cat
PnpLockdown = 1

[SourceDisksNames]
222="A-Volute APO Installation Disk",,,

[SourceDisksFiles]
Sonar.APO.dll=222
Sonar.APOAPI.dll=222
DirectML.dll=222
DnnProcessor.dll=222
microsoft.ai.machinelearning.dll=222
onnxruntime.dll=222

[DestinationDirs]
APO_CopyList       = 13          ; %windir%\system32\DriverStore\FileRepository
Control_CopyList   = 13          ; %windir%\system32\DriverStore\FileRepository

[SignatureAttributes]
Sonar.APO.dll=SignatureAttributes.PETrust

[SignatureAttributes.DRM]
DRMLevel=1300

[SignatureAttributes.PETrust]
PETrust=true

[Manufacturer]
%Mfg% = ApoComponents,NTamd64.10.0...17763

[ApoComponents.NTamd64.10.0...17763]
%Apo.ComponentDesc% = ApoComponent_Install,SWC\VEN_SSGG&AID_0001
%Apo.ComponentDesc% = ApoComponent_Install,SWC\VEN_SSGG&AID_FFFE

[ApoComponent_Install]
CopyFiles = APO_CopyList,Control_CopyList
AddReg    = APO_AddReg


[ApoComponent_Install.Services]
AddService = ,2    ; no function driver

[APO_CopyList]
Sonar.APO.dll

[Control_CopyList]
Sonar.APOAPI.dll
DirectML.dll
DnnProcessor.dll
microsoft.ai.machinelearning.dll
onnxruntime.dll

[APO_AddReg]
; Mic Endpoint effect APO COM registration
HKR,Classes\CLSID\%FX_MODE_MIC_ENDPOINT_CLSID%,,,%MIC_MFX_FriendlyName%
HKR,Classes\CLSID\%FX_MODE_MIC_ENDPOINT_CLSID%\InProcServer32,,0x00020000,"%13%\Sonar.APO.dll"
HKR,Classes\CLSID\%FX_MODE_MIC_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

; Chat Endpoint effect APO COM registration
HKR,Classes\CLSID\%FX_MODE_CHAT_ENDPOINT_CLSID%,,,%CHAT_MFX_FriendlyName%
HKR,Classes\CLSID\%FX_MODE_CHAT_ENDPOINT_CLSID%\InProcServer32,,0x00020000,"%13%\Sonar.APO.dll"
HKR,Classes\CLSID\%FX_MODE_CHAT_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

; Engine Chat Endpoint effect APO COM registration
HKR,Classes\CLSID\%FX_MODE_ENGINE_CHAT_ENDPOINT_CLSID%,,,%ENGINE_CHAT_EFX_FriendlyName%
HKR,Classes\CLSID\%FX_MODE_ENGINE_CHAT_ENDPOINT_CLSID%\InProcServer32,,0x00020000,"%13%\Sonar.APO.dll"
HKR,Classes\CLSID\%FX_MODE_ENGINE_CHAT_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

; Game Endpoint effect APO COM registration
HKR,Classes\CLSID\%FX_GAME_ENDPOINT_CLSID%,,,%GAME_EFX_FriendlyName%
HKR,Classes\CLSID\%FX_GAME_ENDPOINT_CLSID%\InProcServer32,,0x00020000,"%13%\Sonar.APO.dll"
HKR,Classes\CLSID\%FX_GAME_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

; Engine Render Endpoint effect APO COM registration
