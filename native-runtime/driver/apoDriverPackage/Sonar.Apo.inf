HKR,Classes\CLSID\%FX_RENDER_ENGINE_ENDPOINT_CLSID%\InProcServer32,,0x00020000,"%13%\Sonar.APO.dll"
HKR,Classes\CLSID\%FX_RENDER_ENGINE_ENDPOINT_CLSID%\InProcServer32,ThreadingModel,,"Both"

; Mic Endpoint effect APO registration
HKR,AudioEngine\AudioProcessingObjects\%FX_MODE_MIC_ENDPOINT_CLSID%, "FriendlyName", ,%MIC_MFX_FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%FX_MODE_MIC_ENDPOINT_CLSID%, "Copyright", ,%APOCopyRight%
